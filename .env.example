# Path configuration.
#
# Copy this file to `.env` and set the values to match your environment:
#     cp .env.example .env
#
# `.env` is git-ignored and is sourced by the shell scripts and read by the
# Python scripts (via os.environ). Committed code only ever references these
# variable names, never absolute machine paths.

# Repository root (where this code lives). Used for writing results/outputs.
REPO_ROOT=/path/to/Tokenizer_UMM

# Root directory holding datasets / tokenized data / eval benchmark data.
DATA_ROOT=/path/to/data

# Root directory holding model checkpoints.
CKPT_ROOT=/path/to/checkpoints

# HuggingFace datasets cache directory.
HF_CACHE=/path/to/hf_cache

# Conda installation root (used by some eval scripts: $CONDA_ROOT/etc/profile.d/conda.sh).
CONDA_ROOT=/path/to/miniconda3
